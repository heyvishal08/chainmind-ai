# ChainMind AI — Environment Configuration
# Copy this file to .env to configure optional API keys and overrides.

# Groq Cloud API Key (Optional)
# If provided, ChainMind Copilot routes complex natural language queries to Llama 3.3 70B on Groq.
# If left empty, ChainMind seamlessly falls back to its built-in deterministic offline reasoning engine.
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database URL Override (Optional - defaults to SQLite WAL at backend/chainmind.db)
# For enterprise production (e.g. AWS RDS PostgreSQL, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
